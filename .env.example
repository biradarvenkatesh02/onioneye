# OnionEye settings. Copy to `.env` and fill in. Never commit the real `.env`.
# On Vercel, add these under Project -> Settings -> Environment Variables instead.
# The backend loads `.env` from this folder by itself; variables already set in the environment take priority.

# GenAI advisor: Groq. Key from https://console.groq.com/keys
# Without a key the advisor still works, using its offline rulebook.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
